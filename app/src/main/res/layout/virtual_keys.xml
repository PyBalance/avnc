<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        android:backgroundTint="#cfff"
        android:backgroundTintMode="multiply"
        android:theme="@style/ThemeOverlay.MaterialComponents.Light"
        android:contentDescription="Virtual Keys"
        tools:ignore="HardcodedText">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!--
        This is a temporary host for pages. It simplifies the design & inflation of keys.
        Children of this ViewGroup will be detached at runtime and added to pager above.
        -->
        <LinearLayout
            android:id="@+id/tmp_page_host"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--~~~~~~~~~~~~~~~~~~~~~~~ Primary keys ~~~~~~~~~~~~~~~~~~~~~~~~-->
            <LinearLayout
                android:id="@+id/keys_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layoutDirection="ltr"
                android:orientation="horizontal">
                <GridLayout
                    android:id="@+id/fixed_keys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <com.gaurav.avnc.ui.vnc.NestableHorizontalScrollView
                    android:id="@+id/keys_scroll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:id="@+id/keys_host"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <GridLayout
                            android:id="@+id/super_keys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />
                        <GridLayout
                            android:id="@+id/keys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.gaurav.avnc.ui.vnc.NestableHorizontalScrollView>
            </LinearLayout>


            <!--~~~~~~~~~~~~~~~~~~~~~~~ Text box ~~~~~~~~~~~~~~~~~~~~~~~~-->
            <LinearLayout
                android:id="@+id/text_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageButton
                        android:id="@+id/text_page_back_btn"
                        style="@style/VirtualKey.Compact"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/desc_back_btn"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@android:color/black" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/text_mode_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/text_mode_keys"
                            style="@style/TextSendButton.Mode"
                            android:layout_width="wrap_content"
                            android:text="@string/title_text_mode_keys" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/text_mode_clipboard"
                            style="@style/TextSendButton.Mode"
                            android:layout_width="wrap_content"
                            android:text="@string/title_text_mode_clipboard" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <com.gaurav.avnc.ui.vnc.VkEditText
                        android:id="@+id/text_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:background="@null"
                        android:padding="2dp"
                        android:textColor="@android:color/black"
                        android:textColorHint="@android:color/black"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:hint="@string/hint_send_text_to_server"
                        android:imeOptions="actionSend|flagNoFullscreen|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"
                        android:inputType="textMultiLine|textNoSuggestions" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_send_btn"
                        style="@style/TextSendButton"
                        android:text="@string/title_send_text" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_copy_btn"
                        style="@style/TextSendButton"
                        android:text="@string/title_text_copy_only"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/text_clipboard_btn"
                        style="@style/TextSendButton"
                        android:text="@string/title_text_copy_paste"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</layout>
